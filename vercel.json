{
  "rewrites": [
    { "source": "/novos",      "destination": "https://connect-academy-landing.vercel.app" },
    { "source": "/novos/(.*)", "destination": "https://connect-academy-landing.vercel.app/$1" },
    { "source": "/(.*)",       "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron-catalog-emails", "schedule": "*/5 * * * *" },
    { "path": "/api/cron-pix-recovery",   "schedule": "0 * * * *" }
  ]
}
