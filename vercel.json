{
  "redirects": [
    {
      "source": "/novos",
      "destination": "https://connect-academy-landing.vercel.app",
      "permanent": false
    },
    {
      "source": "/portal",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/experience",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/portal/assets/:path*",
      "destination": "/portal/assets/:path*"
    },
    {
      "source": "/portal/app.js",
      "destination": "/portal/app.js"
    },
    {
      "source": "/portal/styles.css",
      "destination": "/portal/styles.css"
    },
    {
      "source": "/portal/",
      "destination": "/portal/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-catalog-emails",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-pix-recovery",
      "schedule": "0 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/portal/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/portal/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/portal/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}