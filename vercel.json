{
  "redirects": [
    { "source": "/novos", "destination": "https://connect-academy-landing.vercel.app", "permanent": false },
    { "source": "/portal", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/portal/assets/:path*", "destination": "/portal/assets/:path*" },
    { "source": "/portal/app.js",        "destination": "/portal/app.js" },
    { "source": "/portal/styles.css",    "destination": "/portal/styles.css" },
    { "source": "/portal/",             "destination": "/portal/index.html" },
    { "source": "/(.*)",                "destination": "/app.html" }
  ],
  "crons": [
    { "path": "/api/cron-catalog-emails", "schedule": "*/5 * * * *" },
    { "path": "/api/cron-pix-recovery",   "schedule": "0 * * * *" }
  ]
}
